# Copie para .env e ajuste. Nenhuma das fontes atuais exige chave de API.
PORT=8787
HOST=127.0.0.1
# Fuso horário padrão (IANA)
MI_TIMEZONE=America/Sao_Paulo
# Cidade padrão (pode ser alterada na tela de configurações)
MI_CITY=São Paulo
MI_LAT=-23.5475
MI_LON=-46.63611
# 1 = usa dados de teste locais (test/fixtures). NUNCA use em produção.
MI_FIXTURES=0
# Chaves futuras (ex.: modelo de IA para o resumo) ficam só no servidor:
# MI_LLM_API_KEY=
